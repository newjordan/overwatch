#!/usr/bin/env bash
# fleet — reach, sessions, and one-screen overwatch for the Tailscale rig fleet.
#
# Roster source of truth (shared with overwatch.py):
#   hosts      <- `tailscale status --json` (auto-discovered, never hardcoded)
#   ssh user   <- ~/.config/fleet-overwatch/config.json  .ssh_users[name] || .default_user
#   role       <- ~/.config/fleet-overwatch/config.json  .roles[name]
#
# Heads bind 127.0.0.1 only, so "see" == ssh-in-and-curl-localhost. ls/status never mutate.
set -uo pipefail

CONF="${FLEET_CONF:-$HOME/.config/fleet-overwatch/config.json}"
TS="$(command -v tailscale 2>/dev/null || echo tailscale)"
HYDRA_PORT="${HYDRA_PORT:-17876}"
SSH_OPTS=(-o ConnectTimeout=15 -o BatchMode=yes -o StrictHostKeyChecking=accept-new)

die() { printf 'fleet: %s\n' "$*" >&2; exit 1; }
command -v jq >/dev/null || die "jq is required"

# --- roster: TSV  name<TAB>ip<TAB>os<TAB>online<TAB>self -------------------
# ONE `tailscale status` per fleet invocation, cached (avoids flaky rapid calls).
_ROSTER=""
roster() {
  if [ -z "$_ROSTER" ]; then
    _ROSTER="$("$TS" status --json 2>/dev/null | jq -r '
      (.Self.DNSName | split(".")[0]) as $self |
      ([.Self] + ((.Peer // {}) | to_entries | map(.value))) | .[] |
      [ (.DNSName | split(".")[0]), (.TailscaleIPs[0] // ""), (.OS // ""), (.Online // false),
        (if (.DNSName | split(".")[0]) == $self then "self" else "peer" end) ] | @tsv
    ')"
  fi
  printf '%s\n' "$_ROSTER"
}

user_for() { jq -r --arg n "$1" '.ssh_users[$n] // .default_user // "frosty40"' "$CONF" 2>/dev/null || echo frosty40; }
role_for() { jq -r --arg n "$1" '.roles[$n] // "-"' "$CONF" 2>/dev/null || echo -; }

# resolve a rig name -> "name ip os online self user" (one line); empty if unknown
resolve() {
  local want="$1" line
  line="$(roster | awk -F'\t' -v n="$want" '$1==n{print; exit}')"
  [ -n "$line" ] || return 1
  IFS=$'\t' read -r name ip os online self <<<"$line"
  printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$ip" "$os" "$online" "$self" "$(user_for "$name")"
}

# list of probeable linux rig names (online), one per line
linux_rigs() { roster | awk -F'\t' '$3=="linux" && $4=="true"{print $1}'; }

# --- remote probe (read-only): run a small script on a rig -----------------
# emits one compact JSON line: {head, gpu, tmux, svc}
PROBE='H=$(curl -s --max-time 2 http://127.0.0.1:'"$HYDRA_PORT"'/status 2>/dev/null||echo "");
G=$(nvidia-smi --query-gpu=name,memory.used,memory.total --format=csv,noheader 2>/dev/null|head -1);
T=$(tmux ls -F "#{session_name}" 2>/dev/null|paste -sd, -);
S=$(systemctl --user is-active hermes-hydra-head.service 2>/dev/null); [ -n "$S" ]||S=$(systemctl is-active hydra-head.service 2>/dev/null); [ -n "$S" ]||S=n/a;
printf "{\"head\":%s,\"gpu\":\"%s\",\"tmux\":\"%s\",\"svc\":\"%s\"}\n" "${H:-null}" "$G" "$T" "$S"'

probe_rig() { # name ip self user -> json line (or {} on failure)
  local name="$1" ip="$2" self="$3" user="$4" out
  if [ "$self" = "self" ]; then
    out="$(bash -c "$PROBE" 2>/dev/null)"
  else
    out="$(ssh -n "${SSH_OPTS[@]}" "${user}@${ip}" "$PROBE" 2>/dev/null)"
  fi
  [ -n "$out" ] && printf '%s' "$out" || printf '{}'
}

# --- commands --------------------------------------------------------------
cmd_ls() {
  printf '%-12s %-22s %-14s %s\n' RIG USER@IP ROLE ONLINE
  roster | while IFS=$'\t' read -r name ip os online self; do
    [ "$os" = "linux" ] || continue
    printf '%-12s %-22s %-14s %s\n' "$name" "$(user_for "$name")@${ip}" "$(role_for "$name")" \
      "$([ "$online" = true ] && echo up || echo offline)$([ "$self" = self ] && echo ' (self)')"
  done
}

cmd_status() {
  local target="${1:-all}"
  roster >/dev/null 2>&1 || true   # warm the cache once (one tailscale call for the whole run)
  printf '%-12s %-6s %-6s %-12s %-18s %-22s %s\n' RIG REACH HEAD GPU VRAM TMUX ROLE
  local names; if [ "$target" = all ]; then names="$(linux_rigs)"; else names="$target"; fi
  # Probe in parallel; ssh -n (in probe_rig) keeps ssh off the loop's stdin.
  local tmp; tmp="$(mktemp -d)"
  while read -r name; do
    [ -n "$name" ] || continue
    local r; r="$(resolve "$name")" || continue
    IFS=$'\t' read -r n ip os online self user <<<"$r"
    ( probe_rig "$n" "$ip" "$self" "$user" >"$tmp/$n" ) &
  done <<<"$names"
  wait
  while read -r name; do
    [ -n "$name" ] || continue
    local j; j="$(cat "$tmp/$name" 2>/dev/null || echo '{}')"
    local headok gpu vram tmuxs reach
    headok=$(jq -r 'if .head==null or .head=="" then "DOWN" elif (.head.ok==true) then "up" else "DOWN" end' <<<"$j" 2>/dev/null || echo "?")
    reach=$([ "$j" = '{}' ] && echo no || echo yes)
    gpu=$(jq -r '.gpu // "" | split(",")[0] | gsub("NVIDIA |GeForce ";"")' <<<"$j" 2>/dev/null)
    vram=$(jq -r '.gpu // "" | (split(",")[1:3]|map(gsub("^ ";""))|join("/"))' <<<"$j" 2>/dev/null)
    tmuxs=$(jq -r '.tmux // "" | if .=="" then "(none)" else . end' <<<"$j" 2>/dev/null)
    printf '%-12s %-6s %-6s %-12s %-18s %-22s %s\n' \
      "$name" "$reach" "$headok" "${gpu:--}" "${vram:--}" "${tmuxs:-(none)}" "$(role_for "$name")"
  done <<<"$names"
  rm -rf "$tmp"
}

cmd_attach() {
  local rig="${1:?usage: fleet attach <rig> [session]}" sess="${2:-main}"
  local r; r="$(resolve "$rig")" || die "unknown rig: $rig"
  IFS=$'\t' read -r n ip os online self user <<<"$r"
  [ "$self" = self ] && exec tmux new -A -s "$sess"
  exec ssh "${SSH_OPTS[@]}" -t "${user}@${ip}" "tmux new -A -s '$sess' 2>/dev/null || { command -v tmux >/dev/null || echo 'tmux not installed — run: fleet bootstrap $rig'; }"
}

cmd_run() {
  local target="${1:?usage: fleet run <rig|all> <cmd...>}"; shift
  local cmd="$*"; [ -n "$cmd" ] || die "no command"
  local names; if [ "$target" = all ]; then names="$(linux_rigs)"; else names="$target"; fi
  while read -r name; do
    [ -n "$name" ] || continue
    local r; r="$(resolve "$name")" || continue
    IFS=$'\t' read -r n ip os online self user <<<"$r"
    echo "── $name ──"
    if [ "$self" = self ]; then bash -c "$cmd"; else ssh -n "${SSH_OPTS[@]}" "${user}@${ip}" "$cmd"; fi
  done <<<"$names"
}

cmd_ssh() {
  local rig="${1:?usage: fleet ssh <rig>}"
  local r; r="$(resolve "$rig")" || die "unknown rig: $rig"
  IFS=$'\t' read -r n ip os online self user <<<"$r"
  [ "$self" = self ] && exec bash -l
  exec ssh "${SSH_OPTS[@]}" -t "${user}@${ip}"
}

cmd_up() { # ensure baseline 'main' session exists (idempotent, detached)
  local target="${1:-all}" names
  if [ "$target" = all ]; then names="$(linux_rigs)"; else names="$target"; fi
  while read -r name; do
    [ -n "$name" ] || continue
    local r; r="$(resolve "$name")" || continue
    IFS=$'\t' read -r n ip os online self user <<<"$r"
    local sh='tmux has-session -t main 2>/dev/null || tmux new-session -d -s main 2>/dev/null && echo main-up || echo no-tmux'
    if [ "$self" = self ]; then echo "$name: $(bash -c "$sh")"; else echo "$name: $(ssh -n "${SSH_OPTS[@]}" "${user}@${ip}" "$sh" 2>/dev/null)"; fi
  done <<<"$names"
}

usage() {
  cat <<EOF
fleet — reach + sessions + overwatch for the rig fleet
  fleet ls                      roster (name, user@ip, role, online)
  fleet status [rig|all]        one-screen overwatch (reach/head/GPU/VRAM/tmux/role)
  fleet attach <rig> [session]  tmux attach-or-create (default: main) over tailscale ssh
  fleet run <rig|all> <cmd...>  run a command on rig(s)
  fleet ssh <rig>               interactive shell on a rig
  fleet up [rig|all]            ensure baseline 'main' tmux session exists
  fleet bootstrap <rig>         (TODO) install tmux/units on a rig
  fleet push [rig|all]          (TODO) sync this CLI to rig(s)
Roster: tailscale status + $CONF
EOF
}

case "${1:-}" in
  ls)        shift; cmd_ls "$@";;
  status|st) shift; cmd_status "$@";;
  attach|a)  shift; cmd_attach "$@";;
  run)       shift; cmd_run "$@";;
  ssh)       shift; cmd_ssh "$@";;
  up)        shift; cmd_up "$@";;
  ""|-h|--help|help) usage;;
  *) usage; exit 1;;
esac
